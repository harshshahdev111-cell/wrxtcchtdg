DEBUG=1
SECRET_KEY=local-development-change-me
LLM_BACKEND=demo
# Set LLM_BACKEND=live for real natural-language understanding.
# Optional: leave blank to use the selected provider's default endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=groq/openai/gpt-oss-20b
# Includes reasoning tokens; too small a limit can truncate the JSON response.
LLM_MAX_COMPLETION_TOKENS=2048
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_SECONDS=25
# ASGI worker heartbeat timeout; this is not an individual request deadline.
GUNICORN_TIMEOUT=30
GUNICORN_WORKERS=2
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=20
# Per ASGI worker: cap live model connections and bound waiting for a free connection.
LLM_MAX_CONNECTIONS=50
LLM_POOL_TIMEOUT=1
AGENT_INPUT_TOKENS=2048
LLM_CONTEXT_TOKENS=8192
# Reserve hosted chat-template overhead separately from exact message-text tokens.
LLM_FRAMING_TOKENS=128
BOOKING_MAX_ATTEMPTS=2
# slot_conflict scenario: comma-separated India-local HH:MM or exact ISO datetimes.
MOCK_CONFLICT_SLOTS=14:00
# PostgreSQL: the backend container uses postgres:5432 internally.
POSTGRES_DB=chat_agent
POSTGRES_USER=chat_agent
POSTGRES_PASSWORD=chat-agent-local-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440
# Optional Docker HTTP host port.
BACKEND_PORT=8001
